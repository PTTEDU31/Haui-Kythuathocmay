[Unit]
Description=HaUI Assist student support application
After=network-online.target student-ai.service
[Service]
Type=simple
WorkingDirectory=/home/phamtung/student-support
Environment=STUDENT_ROOT=/home/phamtung/student-support
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
ExecStart=/home/phamtung/student-support/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088 --no-access-log --limit-concurrency 100 --timeout-keep-alive 10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=default.target
