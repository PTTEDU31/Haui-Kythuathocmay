[Unit]
Description=HaUI student support local AI
After=network-online.target
[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/home/phamtung/student-support/models/ollama
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
ExecStart=/home/phamtung/student-support/tools/bin/ollama serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
