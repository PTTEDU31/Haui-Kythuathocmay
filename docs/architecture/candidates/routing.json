  "cards": [
    {
      "dot": "amber",
      "title": "Evidence and uncertainty",
      "items": [
        "VERIFIED = inspected source at ded15187b5fe; source references are static evidence, not runtime traces.",
        "INFERRED = configuration-based deployment assumption; explicitly prefixed on its arrow.",
        "No origin remote exists. Source paths and pinned excerpts are available in source.html; no remote identity is invented."
      ]
    },
    {
      "dot": "cyan",
      "title": "Execution details",
      "items": [
        "normalize() expands abbreviations and strips accents; classifier normalization retains accents/negation.",
        "Early returns stop later work. Classification only selects a search category and never supplies answer evidence.",
        "search() holds an RLock and rechecks active() on each row; no database or provider I/O occurs inside route()."
      ]
    },
    {
      "dot": "cyan",
      "title": "Fallback thresholds",
      "items": [
        "Implicit questions need top score >= .30. Topic-specific answers need >= .13. Cross-topic conflict/tie margin is .025.",
        "evidence_matches(): query years must exist in FAQ; if >=2 non-topic terms remain, overlap must be >=25%.",
        "Thresholds are engineering rules rather than calibrated probabilities."
      ]
    },
